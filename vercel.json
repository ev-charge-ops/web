{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/\.well-known/(apple-app-site-association|assetlinks\.json)",
      "headers": { "Content-Type": "application/json" },
      "continue": true
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "has": [{ "type": "host", "value": "www.evchargeops.com.br" }],
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "www.evchargeops.com.br" }],
      "dest": "/landing/index.html"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.evchargeops.com.br" }],
      "dest": "/landing/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(?!\.well-known/|media/|landing/)(.*)", "dest": "/index.html" }
  ]
}
